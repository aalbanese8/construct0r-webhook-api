{
  "name": "construct0r-webhook-api",
  "productName": "Construct0r Webhook API",
  "version": "1.0.0",
  "description": "Webhook API for analyzing YouTube, Instagram, and TikTok videos with LANDR-specific insights",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsc -w",
    "build": "tsc && cp -r scripts dist/",
    "start": "node dist/index.js",
    "start:dev": "tsc && node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "webhook",
    "api",
    "video-analysis",
    "youtube",
    "tiktok",
    "instagram",
    "whisper",
    "openai",
    "transcription"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "axios": "^1.6.2",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fluent-ffmpeg": "^2.1.3",
    "multer": "^2.0.2",
    "openai": "^4.20.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.14.0",
    "nodemon": "^3.0.2",
    "typescript": "^5.3.3"
  }
}
